% Per \LaTeX{} default, the |\@date| tag is set to |\today|.
% The output format of dates is set by:
%
% \DescribeOption[common]{localizedates}\DescribeDefault{true}
%	Options: |true|, |false|\\
%	Localizes the date format based on the active language.
%	Also sets the embargo period format (see later).
%	If |false|, the ISO format is used instead (YYYY-MM-DD).
% \iffalse
%<*clo>
\ExplSyntaxOn
\bool_new:N \l_@@_localizedates_bool
\bool_set_true:N \l_@@_localizedates_bool

\keys_define:nn { ugentdocs } {
	localizedates .bool_set:N = \l_@@_localizedates_bool ,
	localizedates .default:n = true ,
}
\ExplSyntaxOff
%</clo>
