%
% \subsection{Fancy chapter headers for the \texttt{phd} and \texttt{course} classes}
%
%    \begin{macrocode}
%<*phd|crs>
\def\@makechapterhead#1{%
  \vspace*{1ex}%
  \begin{flushright}
    \makebox[0pt][l]{\color{titlecolor}\rule[-0.4em]{10cm}{1.8em}}\textcolor{white}
    {\LARGE\textbf{~\chaptername~}}
    \raisebox{-24pt}{
      \begin{tikzpicture}
        \foreach \theta in {0,5,...,355} {
          \node[color=white] at (\theta:0.025)
          {\fontsize{72}{12}\selectfont\textbf{\thechapter}};
        }
        \node[color=titlecolor!50] at (0,0)
        {\fontsize{72}{12}\selectfont\textbf{\thechapter}};
      \end{tikzpicture}
    }\hspace*{-8pt}
    \par\nobreak
    \interlinepenalty\@M
    \huge\textbf{\textcolor{titlecolor}{\rule[-0.5ex]{0em}{2.6ex}~#1}}
    \par\nobreak
  \end{flushright}
  \rule{\textwidth}{1pt}
  \vspace{5\p@}\par\nobreak
  }
\def\@schapter#1{%
  \@makeschapterhead{#1}%
  \@afterheading
}
\def\@makeschapterhead#1{%
  \vspace*{1ex}%
  \begin{flushright}
    \LARGE\textbf{\textcolor{titlecolor}{\rule[-0.5ex]{0em}{2.6ex}~#1}}
  \end{flushright}
  \rule{\textwidth}{1pt}
  \vspace{5\p@}\par
}
% overwrite appendix
\def\appendix{
  \cleardoublepage
  \setcounter{chapter}{0}
  \renewcommand*{\thechapter}{\Alph{chapter}}
  \renewcommand*\chaptername\appendixname
}
%</phd|crs>
%    \end{macrocode}
%
% \subsection{Chapter headers for the \texttt{bama} and \texttt{report} classes}
% Code adapted from Joris Meys' LaTeX at UGent.
%    \begin{macrocode}
%<*bama|rp>
\RequirePackage[raggedright, explicit]{titlesec}

\titleformat{\chapter}
[block] % shape
{\fontsize{16}{19} \selectfont \color{titlecolor} \bfseries } % format
{\thechapter. \ } % the label
{ 0ex } %separator space
{\MakeUppercase{\uline{#1}} } %before code
{ } %after code

\titleformat{\section}
[block] % shape
{\fontsize{14}{17} \selectfont \bfseries } % format
{\thesection \ } % the label
{ 0ex } %separator space
{ #1 } %before code
{ } %after code


% Change the spacing above the chapter. This is left - above - below
\titlespacing*{\chapter}{0pt}{-3em}{12pt}

\titlespacing*{\section}{0pt}{6pt}{0pt}
%</bama|rp>
%    \end{macrocode}
