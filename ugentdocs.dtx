% \newpage
% Some class options change colour handling:
% 
% \DescribeOption[common]{neutralcolors}\DescribeDefault{false}
%	Options: |true|, |false|\\
%	When enabled (|neutralcolors=true| or plain |neutralcolors|), UGent colours override the faculty colour.
%	If the faculty option is empty (see later), UGent colours will always be used.
% 
% \DescribeOption[common]{colormodel}\DescribeDefault{rgb}
%	Options: |rgb|, |cmyk|\\
%	These set the colour model of faculty and UGent colours used.
%	For digital display, rgb is preferable. 
%	Switching to cmyk is reserved for printing,
%	although your printing service may prefer rgb to convert it themselves before printing.
%	Best to ask with them.
% 
% \iffalse
%<*clo>
\ExplSyntaxOn
% Colours
\bool_new:N \l_@@_neutralcolors_bool
\tl_new:N \l_@@_colormodel_tl
\tl_set:Nn \l_@@_colormodel_tl {rgb}

\keys_define:nn { ugentdocs } {
	neutralcolors .bool_set:N = \l_@@_neutralcolors_bool ,
	neutralcolors .default:n = true ,
	colormodel .tl_set:N = \l_@@_colormodel_tl ,
	cmyk .code:n = { \tl_set:Nn \l_@@_colormodel_tl {cmyk} } ,
	rgb .code:n = { \tl_set:Nn \l_@@_colormodel_tl {rgb} } ,
}
\ExplSyntaxOff
%</clo>
%<*col>
\ExplSyntaxOn
\tl_if_empty:NT \l_@@_fselector_tl {
	\bool_set_true:N \l_@@_neutralcolors_bool
}

\bool_if:NTF \l_@@_neutralcolors_bool {
	\colorlet{ugent@faculty}{ugent@main}
}{
	\colorlet{ugent@faculty}{ugent@\@fselector}
}
\ExplSyntaxOff
%</col>
