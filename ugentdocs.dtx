% 
% To support multi-language documents and automatically setting all template
% text -- e.g., copyright page, faculty name, or other specific terms set by
% the class -- a dictionary system was implemented.
% \iffalse
%<*clo>
\ExplSyntaxOn
% Dictionaries: translation machinery
\prop_new:N \g_@@_dict_keyvals_prop
\seq_new:N  \l_@@_value_paragraphs_seq
\tl_new:N \l_@@_lookup_key_tl
\tl_new:N \l_@@_value_cased_tl

\cs_new:Npn \_@@_translate:nn #1#2 {
	\tl_set:Nx \l_@@_lookup_key_tl { \languagename {} :#2 }
	\prop_if_in:NVTF \g_@@_dict_keyvals_prop \l_@@_lookup_key_tl {
		\tl_set:Nx \l_@@_value_cased_tl { \prop_item:NV \g_@@_dict_keyvals_prop \l_@@_lookup_key_tl }
	}{
		\tl_set:Nx \l_@@_lookup_key_tl { english:#2 }
		\tl_set:Nx \l_@@_value_cased_tl { \prop_item:NV \g_@@_dict_keyvals_prop \l_@@_lookup_key_tl }
	}
	\tl_if_empty:nF {#1} {
		\str_case:nnF {#1}{
			{uppercase}{\tl_set:Nx \l_@@_value_cased_tl{\text_uppercase:n{\l_@@_value_cased_tl}}}
			{lowercase}{\tl_set:Nx \l_@@_value_cased_tl{\text_lowercase:n{\l_@@_value_cased_tl}}}
		}{
		}
	}
	\regex_split:nVN { __NEWLINE__ } \l_@@_value_cased_tl \l_@@_value_paragraphs_seq
	\seq_use:Nn \l_@@_value_paragraphs_seq { \newline\newline }
}

% Dictionaries: key-value parsing
\tl_new:N \l_@@_key_tl
\tl_new:N \l_@@_value_tl
\bool_new:N \l_@@_keyval_flushpending_bool
\tl_new:N \l_@@_dictlang_tl
\tl_new:N \l_@@_dictkey_tl

\cs_new_nopar:Nn \@@_flush_value: {
	\bool_if:NT \l_@@_keyval_flushpending_bool {
		\tl_trim_spaces:N \l_@@_value_tl
		\tl_set:Nx \l_@@_dictkey_tl { \l_@@_dictlang_tl {} :\l_@@_key_tl }
		\prop_gput:NVx \g_@@_dict_keyvals_prop \l_@@_dictkey_tl { \l_@@_value_tl }
		\bool_set_false:N \l_@@_keyval_flushpending_bool
	}
}

\cs_new_nopar:Npn \@@_dictparser:w #1 = #2 \q_stop {
	\tl_set:Nn \l_@@_key_tl{#1}
	\tl_set:Nn \l_@@_value_tl{#2}
	\tl_trim_spaces:N \l_@@_key_tl
	\tl_trim_spaces:N \l_@@_value_tl
}

% Dictionaries: dictionary file reader
\ior_new:N \l_@@_dict_ior
\cs_new_nopar:Nn \@@_dictreader:n {
	\tl_set:Nn \l_@@_dictlang_tl {#1}
	\bool_set_false:N \l_@@_keyval_flushpending_bool
	\ior_open:Nn \l_@@_dict_ior { ugentdocs-#1.dict }
	\ior_str_map_inline:Nn \l_@@_dict_ior {
		\tl_if_blank:nTF {##1}{
			\@@_flush_value:
		}{
			\regex_match:nnTF {=} {##1}{
				\@@_flush_value:
				\@@_dictparser:w ##1 \q_stop
				\bool_set_true:N \l_@@_keyval_flushpending_bool
			}{
				\tl_put_right:Nx \l_@@_value_tl { ~ ##1 }
			}
		}
	}
	\@@_flush_value:
	\ior_close:N \l_@@_dict_ior
}
\ExplSyntaxOff
%</clo>
% \fi
% A key can be translated to the currently active babel language using:
%
% \DescribeMacro[common]{\translatekey}\oarg{expand}\oarg{casing}\marg{key}\\
%	Translates the |<key>| using the currently active language (babel), either the main
%	language, overridden with \txtcmd{selectlanguage\{<languagename>\}} or
%	temporarily set using the\\ \txtcmd{foreignlanguage\{<languagename>\}\{\ldots\}}
%	wrapper. A list of keys can be found in the dictionaries below.\\
%	Optional arguments:\\
%	|expand| - expands the |key|, for use with a key such as |org-\@fselector|\\
%	|uppercase| or |lowercase| - changes key result casing.
% 
% \iffalse
%<*clo>
% Dictionaries: translate keys
\ExplSyntaxOn
\cs_generate_variant:Nn \_@@_translate:nn { xn, xx }
\bool_new:N \l_@@_expand_bool
\tl_new:N \l_@@_case_tl

\NewDocumentCommand{\translatekey}{O{} m}{
	\bool_set_false:N \l_@@_expand_bool
	\tl_clear:N \l_@@_case_tl
	\clist_map_inline:nn {#1} {
		\str_case:nnF {##1}{
			{expand}    { \bool_set_true:N \l_@@_expand_bool 		}
			{uppercase} { \tl_set:Nn \l_@@_case_tl {uppercase} 	}
			{lowercase} { \tl_set:Nn \l_@@_case_tl {lowercase} 	}
		}{
			\msg_error:nnn {ugentdocs}{Unknown~translatekey~option}{##1}
		}
	}
	\bool_if:NTF \l_@@_expand_bool {
		\_@@_translate:xx {\l_@@_case_tl} {#2}
	}{ 
		\_@@_translate:xn {\l_@@_case_tl} {#2}
	}
}
\ExplSyntaxOff
%</clo>
% \fi
%
% By default, only english and dutch dictionaries are supported, but a different
% language can be loaded using:
%
% \DescribeMacro[common]{\useugentdocsdictionary}\marg{languagename}\\
%	When used, the dictionary reader will load a file named
%	|ugentdocs-<languagename>.dict| into the dictionary library.
%	If you want to use this language as main document language, be sure to load
%	the |babel| package again immediately after class load using\\
%	\txtcmd{usepackage[main=<languagename>]\{babel\}}.
% 
% \iffalse
%<*clo>
\ExplSyntaxOn
% Dictionaries: translation macro
\seq_new:N  \g_@@_loaded_dicts_seq
\NewDocumentCommand{\useugentdocsdictionary}{m}{
	\seq_if_in:NnTF \g_@@_loaded_dicts_seq {#1}{
	}{
		\@@_dictreader:n {#1}
		\seq_gput_right:Nn \g_@@_loaded_dicts_seq {#1}
	}
}

