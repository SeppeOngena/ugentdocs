%
% The documents use specific derived colours for typesetting contents:
% \begin{itemize}
%	\item \textcolor{titlecolor}{|titlecolor|} (ugent@main): chapter and section titles
%	\item \textcolor{toccolor}{|toccolor|} (black): table of contents
%	\item \textcolor{hypercolor}{|hypercolor|} (ugent@main!50!black): hyperlinks, in-text citations
%	\item \textcolor{watermarkcolor}{|watermarkcolor|} (lightgray): course, exam, and report watermarks
%	\item \textcolor{insetboxcolor}{|insetboxcolor|} (ugent@faculty): insettext and insetquote box colors
% \end{itemize}
%
% \iffalse
%<*col>
\ExplSyntaxOn
\colorlet{titlecolor}{ugent@main}
\colorlet{toccolor}{black}
\colorlet{hypercolor}{ugent@main!50!black}
\colorlet{watermarkcolor}{lightgray}
\colorlet{insetboxcolor}{ugent@faculty}
\ExplSyntaxOff
%</col>
% \fi
%
% Likewise, the cover pages set some colours, although these differ per class:
% \begin{itemize}
%	\item |covertitlecolor|: Cover title and subtitle
%	\item |coverdatacolor|: Cover data text (e.g., author, supervisors, academic year)
%	\item |coverbgcolor|: Main cover background (full page except UGent and faculty logos)
%	\item |coverareacolor|: Cover data area (in bottom left for PhDs and courses)
%	\item |spinecolor|: Spine (for PhDs and courses)
%	\item |spinetextcolor|: Spine text - title (for PhDs and courses)
%	\item |spinetextcoloralt|: Spine text - author \& year (for PhDs and courses)
% \end{itemize}
%
% \iffalse
%<*col>
\ExplSyntaxOn
\exp_args:NnV \clist_if_in:nnT { bama, report } \l_@@_covertype_tl {
	\bool_if:NTF \l_@@_coverbg_bool {
		\colorlet{covertitlecolor}	{white}
		\colorlet{coverdatacolor}	{white}
		\colorlet{coverbgcolor}		{ugent@faculty}
	}{
		\colorlet{covertitlecolor}	{ugent@main}
		\colorlet{coverdatacolor}	{black}
		\colorlet{coverbgcolor}		{white}
	}
}
\str_if_eq:VnT \l_@@_covertype_tl {phd} {
	\bool_if:NTF \l_@@_bwbookcover_bool { % BW cover
		\colorlet{covertitlecolor}	{white}
		\colorlet{coverdatacolor}	{white}
		\colorlet{coverbgcolor}		{lightgray}
		\colorlet{coverareacolor}	{ugent@faculty}
		\colorlet{spinecolor}		{ugent@main}
		\colorlet{spinetextcolor}	{white}
		\colorlet{spinetextcoloralt}{white}
	}{ % UGent cover
		\colorlet{covertitlecolor}	{ugent@faculty}
		\colorlet{coverdatacolor}	{white}
		\colorlet{coverbgcolor}		{ugent@faculty!10}
		\colorlet{coverareacolor}	{ugent@faculty}
		\colorlet{spinecolor}		{white}
		\colorlet{spinetextcolor}	{ugent@main}
		\colorlet{spinetextcoloralt}{ugent@faculty}
	}
}
\str_if_eq:VnT \l_@@_covertype_tl {course} {
	\colorlet{covertitlecolor}	{white}
	\colorlet{coverdatacolor}	{white}
	\tl_if_empty:NTF \l_@@_fselector_tl {
		\colorlet{coverbgcolor}	{ugent@accent}
	}{
	\bool_if:NTF \l_@@_neutralcolors_bool {
		\colorlet{coverbgcolor}	{ugent@accent}
	}{
		\colorlet{coverbgcolor}	{ugent@faculty}
	}
	}
	\colorlet{coverareacolor}	{ugent@main}
	\colorlet{spinecolor}		{white}
	\colorlet{spinetextcolor}	{ugent@main}
	\colorlet{spinetextcoloralt}{ugent@faculty}
}
