% \section{Examples}
% \label{S:examples}
%
% Below you can find an example for every class. They also serve as
% their quickstart documentation.
%
% Remember to
% \begin{itemize}
% \item Use a modern compiler: no pdf\LaTeX{}, use \LuaLaTeX{} instead!
% \item Compile your source file twice or thrice. Most modern editors do this
%    automatically
% \end{itemize}
%
% In many of the classes, you need to specify a faculty option. The
% available faculty options are listed in a table on page \pageref{S:classopt}.
%
% \subsection{\texttt{ugentcourse}}
%
% \begin{Verbatim}
%<*crs-example>
\documentclass[bw,11pt,twoside,openright,dutch]{ugentcourse}
%% faculty            Specifies the faculty abbreviation, can be empty*.
%%                    Used in colouring, logos, and text.
%%                    Options: bw, di, ea, re, we, pp, lw, eb, ps, ge, fw
%% campus             Specifies the campus, overriding UGent logo
%%                    Options: ugent*, gugc, kortrijk
%% neutralcolors      Uses ugent colour scheme instead of faculty colors
%%                    Options: true, false*
%% colormodel         Uses rgb (display) or cmyk (print) colouring
%%                    Options: rgb*, cmyk
%% language           Sets the document main language. Determines, i.a., logo
%%                    and copyright language. Can be overridden locally for the text
%%                    using \selectlanguage or \foreignlanguage (see babel package)
%%                    Options: english* / dutch
%% 11pt               Sets the font size to 11pt
%% twoside            If you want a two-sided document, change to oneside if you
%%                    want a recto only document
%% openright          Causes you chapters to start on a right-hand page when
%%                    your document is twosided
%% nameformat         Format all names as "surname firstname"
%%                    or "firstname surname"
%%                    Options: surnamefirst, surnamelast* 
%% cameraready        Embeds the official 24 cm x 18 cm into an A4 page and
%%                    trigger alignment marks and cut-lines for your printing service
%%                    This will also apply to the generated bookcover file.
%%                    Options: true, false*
%% copyright          Prints a copyright watermark
%%                    Options: true, false*
%% bare               Removes front and back cover. Many
%%                    print services require this format for the contents.
%%                    Options: true, false*
%% thumbs             Adds chapter thumbs to the side of the pages
%%                    Options: true*, false
%% *default

%% You may want to use common fonts such as arial (still within house style)
%%\setsansfont{Arial}[
%%BoldFont           = {Arial},
%%BoldFeatures       = {FakeBold=2.5},
%%ItalicFont         = {Arial},
