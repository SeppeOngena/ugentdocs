%<*phd|bkc|bama>
\ExplSyntaxOn
\tl_new:N \l_@@_embargotemp_tl
\seq_new:N \l_@@_embargosplit_seq
\cs_new:Nn \_@@_embargosubstitute:nN {
	\regex_split:nVN {#1} \l_@@_embargotemp_tl \l_@@_embargosplit_seq
	\tl_clear:N \l_@@_embargotemp_tl
	\tl_put_right:Nx \l_@@_embargotemp_tl { \seq_item:Nn \l_@@_embargosplit_seq {1} }
	\tl_put_right:Nx \l_@@_embargotemp_tl { \exp_not:V #2 }
