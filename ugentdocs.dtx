	txtcentered=true,
	topthumbmargin=3in
	]{thumbs}
	
	\newcommand*{\@addthumb}{%
		\addthumb{\chaptername~\thechapter}% Full chapter name
			{\Large\bfseries\thechapter}% Chapter name in thumb (\thechapter = 1, 2, ...)
