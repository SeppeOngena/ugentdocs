%
% \DescribeMacro[common]{\date}\marg{new date}\DescribeDefault{\today}\margintag{(tag)}\\
%	Sets the document date.
%	If the date is input as ISO format, it is localized
%	based on the |localizedates| option. If not, the date is printed verbatim.
% \iffalse
%<*clo>
\ExplSyntaxOn
\renewcommand{\date}[1]{
	\regex_match:nnTF {^\d{4}-\d{2}-\d{2}$} {#1}%$
	{ \gdef\@date{\DTMdate{#1}} }
	{ \gdef\@date{#1} }
}
