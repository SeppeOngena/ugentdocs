\setlength\@PW{210mm}
\setlength\@PH{297mm}
\@setgridunit
\RequirePackage[paperwidth=\@PW,paperheight=\@PH,
				top=2.54cm, bottom=2.54cm, left=2\gridunit, right=2\gridunit]{geometry}
%</bama>
%<*le>
\setlength\@PW{210mm}
\setlength\@PH{297mm}
\@setgridunit
\RequirePackage[a4paper, footskip=4\gridunit,
				top=5\gridunit, bottom=4\gridunit, left=2\gridunit, right=4.07cm]{geometry}
