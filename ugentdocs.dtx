% \begin{imacro}{\generatebookcover}
%	This macro generates a cover.tex file from your current document.
%    \begin{macrocode}
%<*phd|crs>
\ExplSyntaxOn
\fp_new:N \l_@@_paperweight_fp
\fp_new:N \l_@@_paperbulk_fp
\fp_new:N \l_@@_pagecount_fp

\tl_new:N \l_@@_title_tl
\tl_new:N \l_@@_subtitle_tl
\tl_new:N \l_@@_isbn_tl
\tl_new:N \l_@@_coverimage_tl
\tl_new:N \l_@@_backcoverlogos_tl
\tl_new:N \l_@@_frontcoverlogos_tl
\tl_new:N \l_@@_academicyear_tl

\tl_new:N \l_@@_year_tl
\tl_new:N \l_@@_camerareadykeyval_tl
\tl_new:N \l_@@_covertypekeyval_tl
\tl_new:N \l_@@_covertemplate_tl

\newcommand\generatebookcover{
	\fp_set:Nn \l_@@_paperweight_fp { 80 } % g/m2
	\fp_set:Nn \l_@@_paperbulk_fp   { 1.25 } % cm3/g
	\bool_if:NTF \l_@@_bare_bool {
		\fp_set:Nn \l_@@_pagecount_fp  { \ztotpages }
	}{
		\fp_set:Nn \l_@@_pagecount_fp  { \ztotpages - 2}
	}
	
	\dim_new:N \l_@@_spinewidth_dim
	\dim_set:Nn \l_@@_spinewidth_dim {\fp_to_decimal:n {\l_@@_pagecount_fp/2*\l_@@_paperweight_fp/1e6*\l_@@_paperbulk_fp*1e3} mm}
	
	\tl_set:Nx \l_@@_title_tl       	{ \exp_not:n{\@title} }
	\tl_set:Nx \l_@@_subtitle_tl    	{ \exp_not:n{\@subtitle} }
	\tl_set:Nx \l_@@_isbn_tl			{ \exp_not:n{\@isbn} }
	\tl_set:Nx \l_@@_coverimage_tl 		{ \exp_not:n{\@coverimage} }
	\tl_set:Nx \l_@@_backcoverlogos_tl	{ \exp_not:n{\@backcoverlogos} }
	\tl_set:Nx \l_@@_frontcoverlogos_tl	{ \exp_not:n{\@frontcoverlogos} }
	
	\tl_set:Nx \l_@@_year_tl 			{ \exp_not:n{\the\year} }
	\tl_set:Nx \l_@@_academicyear_tl	{ \exp_not:n{\@academicyear} }
	
	\tl_clear_new:N \l_@@_authorcalls_tl
	\seq_map_inline:Nn \g_@@_authorcalls_seq
	{ \tl_put_right:Nn \l_@@_authorcalls_tl { ##1 \iow_newline: } }
	
	\tl_clear_new:N \l_@@_degreecalls_tl
	\seq_map_inline:Nn \g_@@_degreecalls_seq
	{ \tl_put_right:Nn \l_@@_degreecalls_tl { ##1 \iow_newline: } }
	
	\exp_args:Nx \str_case:nnF { \l_@@_covertype_tl } {
		{ phd }    {
			\tl_clear_new:N \l_@@_supervisorcalls_tl
			\seq_map_inline:Nn \g_@@_supervisorcalls_seq
			{ \tl_put_right:Nn \l_@@_supervisorcalls_tl { ##1 \iow_newline: } }
			\bool_if:NTF \l_@@_cameraready_bool	{
				\tl_set:Nn \l_@@_camerareadykeyval_tl { ,cameraready=true }
			}{
				\tl_set:Nn \l_@@_camerareadykeyval_tl { ,cameraready=false }
			}
			\tl_set:Nn \l_@@_covertypekeyval_tl { ,phd }
		}
		{ course }     {
			\tl_clear_new:N \l_@@_lecturercalls_tl
			\seq_map_inline:Nn \g_@@_lecturercalls_seq
			{ \tl_put_right:Nn \l_@@_lecturercalls_tl { ##1 \iow_newline: } }
			\tl_set:Nx \l_@@_camerareadykeyval_tl { }
			\tl_set:Nn \l_@@_covertypekeyval_tl { ,course }
		}
	}{
		\msg_error:nnx { ugentdocs } { cover~type~not~implemented } { \l_@@_covertype_tl }
	}
	
	\tl_set:Nn \l_@@_covertemplate_tl {
		\exp_not:N\documentclass[\l_@@_fselector_tl, spinewidth=\fp_to_decimal:n{round(\dim_ratio:nn{\l_@@_spinewidth_dim}{1mm},1)}mm
		\l_@@_camerareadykeyval_tl
		,\l_@@_colormodel_tl
		,\l_@@_language_tl
		,\l_@@_nameformat_tl
		\l_@@_covertypekeyval_tl]{ugentbookcover}\iow_newline:
		\c_percent_str~Currently,~a~for~80~g/m2~paper~with~a~bulk~of~1.25~cm3/g~is~assumed~(0.1~mm~caliper~or~thickness).\iow_newline:
		\c_percent_str~Page~count~is~\fp_to_decimal:n{round(\l_@@_pagecount_fp,0)}~pages.~Adjust~spinewidth~if~necessary~using:\iow_newline:
		\c_percent_str~spinewidth~=~page~count~/~2~*~grammage~*~bulk~=~page~count~/~2~*~caliper\iow_newline:
		\iow_newline:
		\exp_not:N\title			{\l_@@_title_tl}			\iow_newline:
		\exp_not:N\subtitle			{\l_@@_subtitle_tl}			\iow_newline:
		\l_@@_authorcalls_tl								    \iow_newline:
		\exp_not:N\isbn				{\l_@@_isbn_tl}				\iow_newline:
		\exp_not:N\coverimage		{\l_@@_coverimage_tl}	\iow_newline:
		\exp_not:N\backcoverlogos	{\l_@@_backcoverlogos_tl}	\iow_newline:
		\exp_not:N\frontcoverlogos	{\l_@@_frontcoverlogos_tl}	\iow_newline:							
	}
	
	\bool_if:NTF \l_@@_bwbookcover_bool {
	\tl_put_right:Nn \l_@@_covertemplate_tl {
		\iow_newline:
		\exp_not:N\year=\l_@@_year_tl\iow_newline:
	}
	}{
	\tl_put_right:Nn \l_@@_covertemplate_tl {
		\iow_newline:
		\l_@@_degreecalls_tl							\iow_newline:
		\exp_not:N\academicyear	{\l_@@_academicyear_tl}	\iow_newline:
	}
	}
	
	\exp_args:Nx \str_case:nnF { \l_@@_covertype_tl } {
		{ phd }    {
			\tl_put_right:Nn \l_@@_covertemplate_tl {
				\l_@@_supervisorcalls_tl									   \iow_newline:
				\bool_if:NT \l_@@_embargo_bool {
					\bool_if:NTF \l_@@_embargotemp_bool {
						\exp_not:N\embargo[start=\l_@@_embargostartdate_tl, end=\l_@@_embargoenddate_tl] \iow_newline:
					}{
						\exp_not:N\embargo \iow_newline:
					}
				}	
			}	
		}
		{ course }     {
			\tl_put_right:Nn \l_@@_covertemplate_tl {
				\l_@@_lecturercalls_tl							\iow_newline:
			}
		}
	}{
		\msg_error:nnx { ugentdocs } { cover~type~not~implemented } { \l_@@_covertype_tl }
	}
	
	\tl_put_right:Nn \l_@@_covertemplate_tl {
		\iow_newline:
		\exp_not:N\begin{document}					\iow_newline:
			\exp_not:N\makebookcover				\iow_newline:
		\exp_not:N\end{document}
	}
	
	\iow_new:N \g_@@_coverfile_iow
	\iow_open:Nn \g_@@_coverfile_iow { \jobname-cover.tex }
	\iow_now:Nx \g_@@_coverfile_iow { \l_@@_covertemplate_tl }
	\iow_close:N \g_@@_coverfile_iow
}
\ExplSyntaxOff
