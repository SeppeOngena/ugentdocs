\ExplSyntaxOn
\exp_args:Nx \str_if_eq:eeT { \l_@@_fselector_tl } { bw } {
	\exp_args:Nx \str_if_eq:eeT { \l_@@_covertype_tl } { phd } {
		\bool_set_true:N \l_@@_bwbookcover_bool
	}
}
