%
% Class loading operates as follows. The standard options such as |11pt|,
% |oneside|, or |openright| are passed to the relevant base classes. For courses,
% BSc/MSc and PhD dissertations, and reports, this is the |book| class. 
% The |ugentletter| class expands |letter|, while exams are based on |article|.
% \iffalse
%<*crs|bama|phd|rp>
\PassOptionsToClass{a4paper,11pt,final,oneside,openright}{book}
\DeclareOption*{\PassOptionsToClass{\CurrentOption, a4paper}{book}}
%</crs|bama|phd|rp>
%<*bkc>
\DeclareOption*{\PassOptionsToClass{\CurrentOption}{bookcover}}
%</bkc>
%<*le>
\PassOptionsToClass{a4paper,10pt,final,oneside}{letter}
\DeclareOption*{\PassOptionsToClass{\CurrentOption}{letter}}
%</le>
%<*ex>
\PassOptionsToClass{a4paper,10pt,final,twoside}{article}
\DeclareOption*{\PassOptionsToClass{\CurrentOption}{article}}
