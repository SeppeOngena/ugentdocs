% Then, our custom options are processed,
% \iffalse
%<*crs|bama|phd|rp|bkc|le|ex>
\ProcessOptions\relax
%</crs|bama|phd|rp|bkc|le|ex>
%<*crs|bama|phd|rp|bkc|le|ex|bmr>
\ProcessKeyOptions[ ugentdocs ]
%</crs|bama|phd|rp|bkc|le|ex|bmr>
% \fi
% and the base classes are loaded in.
% \iffalse
%<*crs|bama|phd|rp>
\LoadClass{book}
%</crs|bama|phd|rp>
%<*bkc>
% Apply bleed space and marker length for cameraready
\newlength{\@bleedspace}
\newlength{\@markerlength}
\ExplSyntaxOn
\bool_if:NTF \l_@@_cameraready_bool {
  \setlength\@bleedspace{3mm}
  \setlength\@markerlength{10mm}
}{
  \setlength\@bleedspace{0mm}
  \setlength\@markerlength{0mm}
}
  
% Set cover dimensions based on cover type
\exp_args:Nx \str_case:nnF { \l_@@_covertype_tl } {
	{ phd }    {
		\PassOptionsToClass{
			coverheight=24cm,
			coverwidth=16cm,
			bleedwidth=\the\@bleedspace,
			marklength=\the\@markerlength
		}{bookcover}
	}
	{ course }     {
		\PassOptionsToClass{
			coverheight=29.7cm,
			coverwidth=21cm,
			bleedwidth=\the\@bleedspace,
			marklength=\the\@markerlength
		}{bookcover}
	}
}{
	\msg_error:nnx { ugentdocs } { cover~type~not~implemented } { \l_@@_covertype_tl }
}
\ExplSyntaxOff
\LoadClass{bookcover}
%</bkc>
%<*le>
\LoadClass{letter}
%</le>
%<*ex>
\LoadClass{article}
