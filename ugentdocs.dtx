%
% \DescribeMacro[common]{\ficon}\marg{height}\marg{color}\marg{alignment}\\
%	When used within a tikzpicture, this prints the faculty icon. The height is a
%	length, the alignment ranges from 0 (left edge) to 1 (right edge).
%	The color can be set to, e.g., white to print on a dark background.\\
%	Usage:
%
% \txtcmd{begin\{tikzpicture\}}\txtcmd{ficon\{1cm\}\{ugent@faculty\}\{0\}}\txtcmd{end\{tikzpicture\}}\\
% \begin{tikzpicture}
%	\ficon{1cm}{ugent@faculty}{0}
% \end{tikzpicture}
%
% \iffalse
%<*clo>
\newcommand{\ficon}[3]{
	\ifx\@fselector\@empty\else
	\pgfmathsetmacro{\@ficonscale}{#1/\@logounit}
	\pgfmathsetmacro{\@ficonxshift}{-#3*\@logounit*\@ficonscale}
	\begin{scope}[	y=1pt, x=1pt, inner sep=0pt, outer sep=0pt,
		shift={(\@ficonxshift, 0.0cm)},yscale=\@ficonscale,xscale=\@ficonscale,
		every node/.append style={scale=\@ficonscale, color=#2},every path/.append style={fill=#2} ]
		\@ficonpath
	\end{scope}
	\fi
}
