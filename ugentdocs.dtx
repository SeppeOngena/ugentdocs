		\ifblank{#1}{%
			\node[fill=insetboxcolor!10, fit=(body), inner sep=0mm] {};
		}{%
			\node[fill=insetboxcolor!10, fit=(body)(title), inner sep=0mm] {};
		}%
		\end{scope}
		\end{tikzpicture}
	\end{adjustbox}
}
