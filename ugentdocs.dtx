% Next, we make the front cover.
% \begin{imacro}{\@frontcover}
%	Defines the front cover layout
%    \begin{macrocode}
%<*bama|rp>
\ExplSyntaxOn
\newcommand{\@frontcover}{
	\begin{tikzpicture}[inner~sep=0pt, outer~sep=0pt]
	\clip (0,0) rectangle (\paperwidth,\paperheight);
	
	\begin{scope}[shift={(0,\paperheight-3*\gridunit)}]
	\faclogo{3*\gridunit}{ugent@\@fselector}{0}
	\end{scope}
	
	\bool_if:NT \l_@@_coverbg_bool {
		\fill[coverbgcolor] (\gridunit,4*\gridunit) rectangle (\paperwidth,\paperheight-\@HTS);
		\begingroup
		\colorlet{hypercolor}{covertitlecolor}
	}
	
	\@coverbody
	
	\begin{scope}[shift={(0,0)}]
		\ugentlogo{4*\gridunit}{ugent@main}{0}
	\end{scope}
	
	\ifx\@frontcoverlogos\@empty\else
		\node[anchor=south~east, inner~sep=0pt,
			text~width=\paperwidth-(2+\@ugenttextw/\@logounit)*\gridunit, minimum~height=2*\gridunit,
			align=right] at (\paperwidth-\gridunit,\gridunit)
			{\@frontcoverlogos};
	\fi
	
	\bool_if:NT \l_@@_coverbg_bool {
		\endgroup
	}
	
	\end{tikzpicture}
}
\ExplSyntaxOff
%</bama|rp>
%    \end{macrocode}
