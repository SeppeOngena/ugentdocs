% \subsubsection{Fonts}
% \label{S:fonts}
% UGent Panno Text and its Medium and SemiLight variants should always be 
% installed\watchout -- and the document compiled using \LuaLaTeX{} -- as they are used in
% the logo's. For the document itself, it is recommended to use UGent Panno Text
% as well, which is why it is set by default through the |\setsansfont{UGent Panno Text}[...]| block
% below. However, Arial is also a valid official alternative and can override
% UGent Panno Text by adding the |\setsansfont{Arial}[...]| block below to the
% beginning of your document. UGent uses Arial as default for Word and
% PowerPoint templates as these are distributed outside Ghent University.
% This is not applicable for \LaTeX however, as pdf's are always generated.
% Thus, UGent Panno Text is the default everywhere.
%
% \begin{verbatim}
% \setsansfont{UGent Panno Text}[
%     BoldFont           = {UGent Panno Text},
%     BoldFeatures       = {FakeBold=2.5},
%     ItalicFont         = {UGent Panno Text},
%     ItalicFeatures     = {FakeSlant=0.15},
%     BoldItalicFont     = {UGent Panno Text},
%     BoldItalicFeatures = {FakeBold=2.5, FakeSlant=0.15},
% ]
% \end{verbatim}
%
% \begin{verbatim}
% \setsansfont{Arial}[
%     BoldFont           = {Arial},
%     BoldFeatures       = {FakeBold=2.5},
%     ItalicFont         = {Arial},
%     ItalicFeatures     = {FakeSlant=0.15},
%     BoldItalicFont     = {Arial},
%     BoldItalicFeatures = {FakeBold=2.5, FakeSlant=0.15},
% ]
% \end{verbatim}	
%
% Since both the official fonts are sans-serif, we use the |unicode-math| package
% with the Noto Sans Math font if available, and the TeX Gyre DejaVu Math
% font otherwise. You can override these fonts by using \txtcmd{setmathfont\{<font>\}}.
%
% \iffalse
%<*clo>
% Fonts
\RequirePackage{iftex}
\iftutex
\newcommand{\@loadfonts}{
	\RequirePackage{fontspec}
	\IfFontExistsTF{UGent Panno Text Medium}{
		\IfFontExistsTF{UGent Panno Text SemiLight}{
			\IfFontExistsTF{UGent Panno Text}{
				\setsansfont{UGent Panno Text}[
				BoldFont           = {UGent Panno Text},
				BoldFeatures       = {FakeBold=2.5},
				ItalicFont         = {UGent Panno Text},
				ItalicFeatures     = {FakeSlant=0.15},
				BoldItalicFont     = {UGent Panno Text},
				BoldItalicFeatures = {FakeBold=2.5, FakeSlant=0.15},
				]
			}{
				\IfFontExistsTF{Arial}{
					\setsansfont{Arial}[
					BoldFont           = {Arial},
					BoldFeatures       = {FakeBold=2.5},
					ItalicFont         = {Arial},
					ItalicFeatures     = {FakeSlant=0.15},
					BoldItalicFont     = {Arial},
					BoldItalicFeatures = {FakeBold=2.5, FakeSlant=0.15},
					]		
				}{
					\PackageWarning{ugentdocs}
					{Neither UGent Panno Text nor Arial are installed, no font set!}
				}
			}
		}{
			\PackageError{ugentdocs}
			{UGent Panno Text Medium and SemiLight font variants are required for logo typesetting}
			{See the ugentdocs manual}
		}
	}{
		\PackageError{ugentdocs}
		{UGent Panno Text Medium and SemiLight font variants are required for logo typesetting}
		{See the ugentdocs manual}
	}
	\IfFontExistsTF{Noto Sans Math}{
		\RequirePackage{unicode-math}
		\setmathfont{Noto Sans Math}
	}{
		\setmathfont{TeX Gyre DejaVu Math}
	}	
	\renewcommand{\familydefault}{\sfdefault}
	}
\else
\PackageError{ugentdocs}{Only LuaTeX or XeTeX is supported for compilation}
{See the ugentdocs manual}
\fi

