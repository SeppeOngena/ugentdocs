%
% When the faculty is specified, the \txtcmd{@faculty} and \txtcmd{@facultyacronym}
% tags are set. You can retrieve these similar to the \LaTeX{}-native \txtcmd{@title} tag by
% wrapping it in \txtcmd{makeatletter} and \txtcmd{makeatother} (required due to the @ sign).
% For example:
% \begin{itemize}
%	\item \txtcmd{makeatletter}\txtcmd{@faculty}\txtcmd{makeatother}:
%		\makeatletter\@faculty\makeatother
%	\item \txtcmd{makeatletter}\txtcmd{@facultyacronym}\txtcmd{makeatother}:
%		\makeatletter\@facultyacronym\makeatother
% \end{itemize}
% \DescribeMacro[common]{\faculty}\marg{name}\margintag{(tag)}\\
%	Overrides the faculty tag \txtcmd{@faculty} with the |name| entered.
%	Name only, no logos or colours! 
%	To use for, e.g., faculty services like |Directie ICT| for letters or beamer slides.
%
% \iffalse
%<*clo>
\ExplSyntaxOn
\NewDocumentCommand{\@faculty}{O{}}{%
	\ifx\@fselector\@empty\else
	\translatekey[#1]{faculty}{}%
	\tl_set:Nx \l_@@_lookup_key_tl { \languagename {} : facultyof }
	\tl_if_empty:eF { \prop_item:NV \g_@@_dict_keyvals_prop \l_@@_lookup_key_tl }
	{~\translatekey[#1]{facultyof}}%
	{~\translatekey[#1,expand]{org-\@fselector}}%
	\fi
}

\newcommand*{\faculty}[1]{%
	\RenewDocumentCommand{\@faculty}{O{}}{
		\str_case:nnF {##1}{
			{uppercase}{\text_uppercase:n{#1}}
			{lowercase}{\text_lowercase:n{#1}}
		}{
			#1
		}
	}%
}
\ExplSyntaxOff

\newcommand*\@facultyacronym{
	\MakeUppercase{F\@fselector}
}
