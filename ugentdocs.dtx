% \subsection{Plain coverpage}
%
% The cover pages tikzpictures for the |bama| and |report| classes are generated
% using the |\@frontcover| and |\@backcover| commands.
% These are used in the |\maketitle| and |\makefinalpage| commands.
%
% First, we need to define the grid layout and colours:
%    \begin{macrocode}
%<*bama|rp>
\newlength{\@TP}\setlength\@TP{26.52cm}												 	% Title Position
\newlength{\@ML}																		% Margin left (for text)
\newlength{\@HTS}																		% Height top strip
%
\ifx\@fselector\@empty
	\setlength\@HTS{0mm}
\else
	\setlength\@HTS{3\gridunit}
\fi
\ExplSyntaxOn
\bool_if:NTF \l_@@_coverbg_bool {
	\setlength\@ML{2\gridunit}
}{
	\setlength\@ML{\gridunit}
}
\ExplSyntaxOff
%</bama|rp>
%    \end{macrocode}
%
% The cover body text differs between |bama| and |report| classes,
% so we set it here. Code adapted from Joris Meys' LaTeX at UGent.
%    \begin{macrocode}
%<*bama|rp>
\ExplSyntaxOn
\newcommand{\@coverbodybama}{
	\node[anchor=north~west, inner~sep=0pt, text~width=\paperwidth-\@ML-\gridunit,
	minimum~height=22.05cm, align=left] at (\@ML,\@TP)
	{%
		\raggedright
		\begin{spacing}{2.5}
			{\fontsize{25}{30}\selectfont\color{covertitlecolor}\bfseries
				\MakeUppercase{\uline{\@title}}}
		\end{spacing}
		
		\vskip 1em
		
		{\fontsize{15}{18}\selectfont\color{covertitlecolor}
			\MakeUppercase{\@subtitle}}
		
		\vskip 1em
		
		\begingroup\color{coverdatacolor}
		\ifx\@wordcount\@empty\else
		\translatekey{wordcount}:~\@wordcount
		\fi
		
		\bool_if:NTF \l_@@_embargo_bool {
			\vskip 5em
			{\fontsize{15}{18}\selectfont\translatekey[uppercase]{confidential}}
			\vskip 5em
		}{
			\vskip 10em
		}
		
		{\fontsize{15}{18}\selectfont\printseq{authorswithaffiliation}{\\}{\\}{\\}}
		
		\ifx\@studentnr\@empty\else
		\translatekey{studentnr}:~\@studentnr
		\fi
		
		\vskip 1em
		
		{\fontsize{12}{15}\selectfont
			\getseqcaption{supervisors}{:~\printseq{supervisors}{~\&~}{,~}{\translatekey{andlist}~}\\}}
		
		\ifseqempty{cosupervisors}{}{
			{\fontsize{12}{15}\selectfont
				\getseqcaption{cosupervisors}{:~\printseq{cosupervisors}{~\&~}{,~}{\translatekey{andlist}~}\\}}
		}
		
		\ifseqempty{extsupervisors}{}{
			{\fontsize{12}{15}\selectfont
				\getseqcaption{extsupervisors}{:~\printseq{extsupervisors}{~\&~}{,~}{\translatekey{andlist}~}\\}}
		}
		
		\ifseqempty{tutors}{}{
			\vskip 1em
			{\fontsize{12}{15}\selectfont
				\getseqcaption{tutors}{}:~\printseq{tutors}{~\&~}{,~}{\translatekey{andlist}~}}
		}
		
		\vskip 1em
		
		{\@doctype{}~\translatekey[lowercase]{submittedto}\ifx\@fselector\@empty\else{}~\translatekey[lowercase]{the-de}~\@faculty{}~\translatekey[lowercase]{of}\fi{}~\translatekey{org-deugent},~\translatekey{bmfulfil}~\printseq{degrees}{~\&~}{,~}{\translatekey{andlist}~}}
		
		\vskip 1em
		\translatekey{acyear}:~\@academicyear
		\endgroup
	};
}

\newcommand{\@coverbodyreport}{
	\node[anchor=north~west, inner~sep=0pt, text~width=\paperwidth-\@ML-\gridunit,
	minimum~height=22.05cm, align=left] at (\@ML,\@TP)
	{%
		\raggedright
		\begin{spacing}{2.5}
			{\fontsize{25}{30}\selectfont\color{covertitlecolor}\bfseries
				\MakeUppercase{\uline{\@title}}}
		\end{spacing}
		
		\vskip 1em
		
		{\fontsize{15}{18}\selectfont\color{covertitlecolor}
			\MakeUppercase{\@subtitle}}
				
		\vskip 2em
		
		\begingroup\color{coverdatacolor}
		\ifx\@extra\@empty\else
		{\fontsize{12}{15}\selectfont\@extra}
		\fi
		
		\ifx\@wordcount\@empty\else
		\translatekey{wordcount}:~\@wordcount
		\fi
		
		\ifseqempty{authors}{
			\vskip 10em
		}{
			\vskip 5em
			{\fontsize{12}{15}\selectfont\printseq{authorswithaffiliation}{\\}{\\}{\\}}
			\ifx\@studentnr\@empty\else
			\translatekey{studentnr}:~\@studentnr
			\fi
			\vskip 5em
		}
		
		\ifseqempty{lecturers}{}{
			{\fontsize{12}{15}\selectfont
				\getseqcaption{lecturers}{}:~\printseq{lecturers}{~\&~}{,~}{\translatekey{andlist}~}}
			\vskip 2 em
		}
		
		\ifx\@address\@empty\else
		{\fontsize{12}{15}\selectfont\@address}
		\vskip 2 em
		\fi
		
		\ifx\@academicyear\@empty\else
		{\fontsize{12}{15}\selectfont\translatekey{acyear}:~\@academicyear}
		\fi
		\endgroup
	};
}

\newcommand*\@coverbody{
	\exp_args:Nx \str_case:nnF { \l_@@_covertype_tl } {
		{ bama } { \@coverbodybama }
		{ report } { \@coverbodyreport }
	}{
		\msg_error:nnx { ugentdocs } { cover~type~not~implemented } {\l_@@_covertype_tl }
	}
}
\ExplSyntaxOff
