\newlength{\@PH}      % Paper height
\newlength{\gridunit} % Grid unit layout
\newcommand*{\@setgridunit}{\pgfmathsetlength{\gridunit}{max(\@PW,\@PH)/7/4}}
%</crs|bama|phd|rp|le|ex|bkc|bmr>
% \fi
%
% The paper size and margins are then set based on the official Office templates:
%    \begin{macrocode}
